//! base 0.1.0
package 'Modelica_Electrical_Analog_Examples_ChuaCircuit'
  model 'Modelica_Electrical_Analog_Examples_ChuaCircuit' "Chua's circuit, ns, V, A"
    Real 'L.i'(quantity = "ElectricCurrent", unit = "A", start = 0, fixed = true) "Current flowing from pin p to pin n";
    Real 'L.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'L.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'L.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'L.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'L.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'L.L'(quantity = "Inductance", unit = "H") = 18 "Inductance";
    Real 'Ro.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'Ro.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'Ro.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'Ro.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'Ro.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'Ro.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Boolean 'Ro.useHeatPort' = false "= true, if heatPort is enabled";
    parameter Real 'Ro.T'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 'Ro.T_ref' "Fixed device temperature if useHeatPort = false";
    Real 'Ro.LossPower'(quantity = "Power", unit = "W") "Loss power leaving component via heatPort";
    Real 'Ro.T_heatPort'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, start = 288.15, nominal = 300) "Temperature of heatPort";
    parameter Real 'Ro.R'(quantity = "Resistance", unit = "Ohm") = 0.0125 "Resistance at temperature T_ref";
    parameter Real 'Ro.T_ref'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 300.15 "Reference temperature";
    parameter Real 'Ro.alpha'(quantity = "LinearTemperatureCoefficient", unit = "1/K") = 0 "Temperature coefficient of resistance (R_actual = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'Ro.R_actual'(quantity = "Resistance", unit = "Ohm") "Actual resistance = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'G.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'G.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'G.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'G.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'G.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'G.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Boolean 'G.useHeatPort' = false "= true, if heatPort is enabled";
    parameter Real 'G.T'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 'G.T_ref' "Fixed device temperature if useHeatPort = false";
    Real 'G.LossPower'(quantity = "Power", unit = "W") "Loss power leaving component via heatPort";
    Real 'G.T_heatPort'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, start = 288.15, nominal = 300) "Temperature of heatPort";
    parameter Real 'G.G'(quantity = "Conductance", unit = "S") = 0.565 "Conductance at temperature T_ref";
    parameter Real 'G.T_ref'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 300.15 "Reference temperature";
    parameter Real 'G.alpha'(quantity = "LinearTemperatureCoefficient", unit = "1/K") = 0 "Temperature coefficient of conductance (G_actual = G_ref/(1 + alpha*(T_heatPort - T_ref))";
    Real 'G.G_actual'(quantity = "Conductance", unit = "S") "Actual conductance = G_ref/(1 + alpha*(T_heatPort - T_ref))";
    Real 'C1.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C1.v'(quantity = "ElectricPotential", unit = "V", start = 4, fixed = true) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C1.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C1.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C1.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C1.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C1.C'(quantity = "Capacitance", unit = "F", min = 0) = 10 "Capacitance";
    Real 'C2.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C2.v'(quantity = "ElectricPotential", unit = "V", start = 0, fixed = true) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C2.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C2.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C2.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C2.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C2.C'(quantity = "Capacitance", unit = "F", min = 0) = 100 "Capacitance";
    Real 'Nr.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'Nr.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'Nr.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'Nr.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'Nr.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'Nr.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'Nr.Ga'(quantity = "Conductance", unit = "S", min = (-1)) = (-0.757576) "Conductance in inner voltage range";
    parameter Real 'Nr.Gb'(quantity = "Conductance", unit = "S", min = (-1)) = (-0.409091) "Conductance in outer voltage range";
    parameter Real 'Nr.Ve'(quantity = "ElectricPotential", unit = "V") = 1 "Inner voltage range limit";
    Real 'Gnd.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'Gnd.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
  equation
    0 = ('L.p.i' + 'L.n.i');
    'L.i' = 'L.p.i';
    'L.v' = ('L.p.v' - 'L.n.v');
    ('L.L' * der('L.i')) = 'L.v';
    0 = ('Ro.p.i' + 'Ro.n.i');
    'Ro.i' = 'Ro.p.i';
    'Ro.v' = ('Ro.p.v' - 'Ro.n.v');
    'Ro.T_heatPort' = 'Ro.T';
    'Ro.R_actual' = ('Ro.R' * (1 + ('Ro.alpha' * ('Ro.T_heatPort' - 'Ro.T_ref'))));
    'Ro.v' = ('Ro.R_actual' * 'Ro.i');
    'Ro.LossPower' = ('Ro.v' * 'Ro.i');
    0 = ('G.p.i' + 'G.n.i');
    'G.i' = 'G.p.i';
    'G.v' = ('G.p.v' - 'G.n.v');
    'G.T_heatPort' = 'G.T';
    'G.G_actual' = ('G.G' / (1 + ('G.alpha' * ('G.T_heatPort' - 'G.T_ref'))));
    'G.i' = ('G.G_actual' * 'G.v');
    'G.LossPower' = ('G.v' * 'G.i');
    0 = ('C1.p.i' + 'C1.n.i');
    'C1.i' = 'C1.p.i';
    'C1.v' = ('C1.p.v' - 'C1.n.v');
    'C1.i' = ('C1.C' * der('C1.v'));
    0 = ('C2.p.i' + 'C2.n.i');
    'C2.i' = 'C2.p.i';
    'C2.v' = ('C2.p.v' - 'C2.n.v');
    'C2.i' = ('C2.C' * der('C2.v'));
    0 = ('Nr.p.i' + 'Nr.n.i');
    'Nr.i' = 'Nr.p.i';
    'Nr.v' = ('Nr.p.v' - 'Nr.n.v');
    'Nr.i' = (if ('Nr.v' < (-'Nr.Ve')) then (('Nr.Gb' * ('Nr.v' + 'Nr.Ve')) - ('Nr.Ga' * 'Nr.Ve')) else (if ('Nr.v' > 'Nr.Ve') then (('Nr.Gb' * ('Nr.v' - 'Nr.Ve')) + ('Nr.Ga' * 'Nr.Ve')) else ('Nr.Ga' * 'Nr.v')));
    'Gnd.p.v' = 0;
    0 = ('L.n.i' + 'Ro.p.i');
    0 = (('C2.p.i' + 'G.p.i') + 'L.p.i');
    0 = (('G.n.i' + 'Nr.p.i') + 'C1.p.i');
    0 = (((('Ro.n.i' + 'Gnd.p.i') + 'C2.n.i') + 'C1.n.i') + 'Nr.n.i');
    'L.n.v' = 'Ro.p.v';
    'C2.p.v' = 'G.p.v';
    'G.p.v' = 'L.p.v';
    'G.n.v' = 'Nr.p.v';
    'Nr.p.v' = 'C1.p.v';
    'Ro.n.v' = 'Gnd.p.v';
    'Gnd.p.v' = 'C2.n.v';
    'C2.n.v' = 'C1.n.v';
    'C1.n.v' = 'Nr.n.v';
    assert(((1 + ('Ro.alpha' * ('Ro.T_heatPort' - 'Ro.T_ref'))) >= 0.0000000000000002220446049250313), "Temperature outside scope of model!");
    assert(((1 + ('G.alpha' * ('G.T_heatPort' - 'G.T_ref'))) >= 0.0000000000000002220446049250313), "Temperature outside scope of model!");
  annotation(experiment(StopTime = 50000.0, Interval = 1.0));
  end 'Modelica_Electrical_Analog_Examples_ChuaCircuit';
end 'Modelica_Electrical_Analog_Examples_ChuaCircuit';
