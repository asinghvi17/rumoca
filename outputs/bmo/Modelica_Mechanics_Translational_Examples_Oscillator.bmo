//! base 0.1.0
package 'Modelica_Mechanics_Translational_Examples_Oscillator'
  model 'Modelica_Mechanics_Translational_Examples_Oscillator' "Oscillator demonstrates the use of initial conditions"
    Real 'mass1.s'(quantity = "Length", unit = "m", start = (-0.5), fixed = true) "Absolute position of center of component (s = flange_a.s + L/2 = flange_b.s - L/2)";
    parameter Real 'mass1.L'(quantity = "Length", unit = "m") = 1 "Length of component, from left flange to right flange (= flange_b.s - flange_a.s)";
    Real 'mass1.flange_a.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'mass1.flange_a.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'mass1.flange_b.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'mass1.flange_b.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Real 'mass1.m'(quantity = "Mass", unit = "kg", min = 0) = 1 "Mass of the sliding mass";
    Real 'mass1.v'(quantity = "Velocity", unit = "m/s", start = 0, fixed = true) "Absolute velocity of component";
    Real 'mass1.a'(quantity = "Acceleration", unit = "m/s2", start = 0) "Absolute acceleration of component";
    Real 'spring1.s_rel'(quantity = "Length", unit = "m", start = 0) "Relative distance (= flange_b.s - flange_a.s)";
    Real 'spring1.f'(quantity = "Force", unit = "N") "Force between flanges (positive in direction of flange axis R)";
    Real 'spring1.flange_a.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'spring1.flange_a.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'spring1.flange_b.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'spring1.flange_b.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Real 'spring1.c'(quantity = "TranslationalSpringConstant", unit = "N/m", min = 0) = 10000 "Spring constant";
    parameter Real 'spring1.s_rel0'(quantity = "Length", unit = "m", min = 0) = 1 "Unstretched spring length";
    parameter Real 'fixed1.s0'(quantity = "Length", unit = "m") = 1 "Fixed offset position of housing";
    Real 'fixed1.flange.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'fixed1.flange.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Boolean 'force1.useSupport' = false "= true, if support flange enabled, otherwise implicitly grounded";
    Real 'force1.s'(quantity = "Length", unit = "m") "Distance between flange and support (= flange.s - support.s)";
    Real 'force1.flange.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'force1.flange.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'force1.s_support'(quantity = "Length", unit = "m") "Absolute position of support flange";
    Real 'force1.f'(unit = "N") "Driving force as input signal";
    parameter Real 'sine1.offset' = 0 "Offset of output signal y";
    parameter Real 'sine1.startTime'(quantity = "Time", unit = "s") = 0 "Output y = offset for time < startTime";
    Real 'sine1.y' "Connector of Real output signal";
    parameter Real 'sine1.amplitude' = 1 "Amplitude of sine wave";
    parameter Real 'sine1.f'(quantity = "Frequency", unit = "Hz") = 15.9155 "Frequency of sine wave";
    parameter Real 'sine1.phase'(quantity = "Angle", unit = "rad", displayUnit = "deg") = 0 "Phase of sine wave";
    parameter Boolean 'sine1.continuous' = false "Make output continuous by starting at offset + amplitude*sin(phase)";
    Real 'mass2.s'(quantity = "Length", unit = "m", start = (-0.5), fixed = true) "Absolute position of center of component (s = flange_a.s + L/2 = flange_b.s - L/2)";
    parameter Real 'mass2.L'(quantity = "Length", unit = "m") = 1 "Length of component, from left flange to right flange (= flange_b.s - flange_a.s)";
    Real 'mass2.flange_a.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'mass2.flange_a.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'mass2.flange_b.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'mass2.flange_b.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Real 'mass2.m'(quantity = "Mass", unit = "kg", min = 0) = 1 "Mass of the sliding mass";
    Real 'mass2.v'(quantity = "Velocity", unit = "m/s", start = 0, fixed = true) "Absolute velocity of component";
    Real 'mass2.a'(quantity = "Acceleration", unit = "m/s2", start = 0) "Absolute acceleration of component";
    Real 'spring2.s_rel'(quantity = "Length", unit = "m", start = 0) "Relative distance (= flange_b.s - flange_a.s)";
    Real 'spring2.f'(quantity = "Force", unit = "N") "Force between flanges (positive in direction of flange axis R)";
    Real 'spring2.flange_a.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'spring2.flange_a.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'spring2.flange_b.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'spring2.flange_b.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Real 'spring2.c'(quantity = "TranslationalSpringConstant", unit = "N/m", min = 0) = 10000 "Spring constant";
    parameter Real 'spring2.s_rel0'(quantity = "Length", unit = "m", min = 0) = 1 "Unstretched spring length";
    parameter Real 'fixed2.s0'(quantity = "Length", unit = "m") = 1 "Fixed offset position of housing";
    Real 'fixed2.flange.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'fixed2.flange.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Boolean 'force2.useSupport' = false "= true, if support flange enabled, otherwise implicitly grounded";
    Real 'force2.s'(quantity = "Length", unit = "m") "Distance between flange and support (= flange.s - support.s)";
    Real 'force2.flange.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'force2.flange.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'force2.s_support'(quantity = "Length", unit = "m") "Absolute position of support flange";
    Real 'force2.f'(unit = "N") "Driving force as input signal";
    parameter Real 'sine2.offset' = 0 "Offset of output signal y";
    parameter Real 'sine2.startTime'(quantity = "Time", unit = "s") = 0 "Output y = offset for time < startTime";
    Real 'sine2.y' "Connector of Real output signal";
    parameter Real 'sine2.amplitude' = 1 "Amplitude of sine wave";
    parameter Real 'sine2.f'(quantity = "Frequency", unit = "Hz") = 15.9155 "Frequency of sine wave";
    parameter Real 'sine2.phase'(quantity = "Angle", unit = "rad", displayUnit = "deg") = 0 "Phase of sine wave";
    parameter Boolean 'sine2.continuous' = false "Make output continuous by starting at offset + amplitude*sin(phase)";
    parameter Real 'damper1.s_nominal'(quantity = "Length", unit = "m", min = 0) = 0.0001 "Nominal value of s_rel (used for scaling)";
    Real 'damper1.s_rel'(quantity = "Length", unit = "m", start = 0, nominal = 'damper1.s_nominal', stateSelect = StateSelect.prefer) "Relative distance (= flange_b.s - flange_a.s)";
    Real 'damper1.v_rel'(quantity = "Velocity", unit = "m/s", start = 0, stateSelect = StateSelect.prefer) "Relative velocity (= der(s_rel))";
    Real 'damper1.f'(quantity = "Force", unit = "N") "Forces between flanges (= flange_b.f)";
    Real 'damper1.flange_a.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'damper1.flange_a.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    Real 'damper1.flange_b.s'(quantity = "Length", unit = "m") "Absolute position of flange";
    Real 'damper1.flange_b.f'(quantity = "Force", unit = "N") "Cut force directed into flange";
    parameter Boolean 'damper1.useHeatPort' = false "= true, if heatPort is enabled";
    Real 'damper1.lossPower'(quantity = "Power", unit = "W") "Loss power leaving component via heatPort (> 0, if heat is flowing out of component)";
    parameter Real 'damper1.d'(quantity = "TranslationalDampingConstant", unit = "N.s/m", min = 0) = 10 "Damping constant";
  equation
    'mass1.flange_a.s' = ('mass1.s' - ('mass1.L' / 2));
    'mass1.flange_b.s' = ('mass1.s' + ('mass1.L' / 2));
    'mass1.v' = der('mass1.s');
    'mass1.a' = der('mass1.v');
    ('mass1.m' * 'mass1.a') = ('mass1.flange_a.f' + 'mass1.flange_b.f');
    'spring1.s_rel' = ('spring1.flange_b.s' - 'spring1.flange_a.s');
    'spring1.flange_b.f' = 'spring1.f';
    'spring1.flange_a.f' = (-'spring1.f');
    'spring1.f' = ('spring1.c' * ('spring1.s_rel' - 'spring1.s_rel0'));
    'fixed1.flange.s' = 'fixed1.s0';
    'force1.s' = ('force1.flange.s' - 'force1.s_support');
    'force1.s_support' = 0;
    'force1.flange.f' = (-'force1.f');
    'sine1.y' = ('sine1.offset' + (if (time < 'sine1.startTime') then 0 else ('sine1.amplitude' * sin(((((2 * (2 * asin(1.0))) * 'sine1.f') * (time - 'sine1.startTime')) + 'sine1.phase')))));
    'mass2.flange_a.s' = ('mass2.s' - ('mass2.L' / 2));
    'mass2.flange_b.s' = ('mass2.s' + ('mass2.L' / 2));
    'mass2.v' = der('mass2.s');
    'mass2.a' = der('mass2.v');
    ('mass2.m' * 'mass2.a') = ('mass2.flange_a.f' + 'mass2.flange_b.f');
    'spring2.s_rel' = ('spring2.flange_b.s' - 'spring2.flange_a.s');
    'spring2.flange_b.f' = 'spring2.f';
    'spring2.flange_a.f' = (-'spring2.f');
    'spring2.f' = ('spring2.c' * ('spring2.s_rel' - 'spring2.s_rel0'));
    'fixed2.flange.s' = 'fixed2.s0';
    'force2.s' = ('force2.flange.s' - 'force2.s_support');
    'force2.s_support' = 0;
    'force2.flange.f' = (-'force2.f');
    'sine2.y' = ('sine2.offset' + (if (time < 'sine2.startTime') then 0 else ('sine2.amplitude' * sin(((((2 * (2 * asin(1.0))) * 'sine2.f') * (time - 'sine2.startTime')) + 'sine2.phase')))));
    'damper1.s_rel' = ('damper1.flange_b.s' - 'damper1.flange_a.s');
    'damper1.v_rel' = der('damper1.s_rel');
    'damper1.flange_b.f' = 'damper1.f';
    'damper1.flange_a.f' = (-'damper1.f');
    'damper1.f' = ('damper1.d' * 'damper1.v_rel');
    'damper1.lossPower' = ('damper1.f' * 'damper1.v_rel');
    0 = ('mass1.flange_b.f' + 'spring1.flange_a.f');
    0 = (('spring2.flange_a.f' + 'damper1.flange_a.f') + 'mass2.flange_b.f');
    0 = (('damper1.flange_b.f' + 'spring2.flange_b.f') + 'fixed2.flange.f');
    0 = ('spring1.flange_b.f' + 'fixed1.flange.f');
    0 = ('force2.flange.f' + 'mass2.flange_a.f');
    0 = ('force1.flange.f' + 'mass1.flange_a.f');
    'mass1.flange_b.s' = 'spring1.flange_a.s';
    'spring2.flange_a.s' = 'damper1.flange_a.s';
    'damper1.flange_a.s' = 'mass2.flange_b.s';
    'damper1.flange_b.s' = 'spring2.flange_b.s';
    'spring2.flange_b.s' = 'fixed2.flange.s';
    'sine1.y' = 'force1.f';
    'sine2.y' = 'force2.f';
    'spring1.flange_b.s' = 'fixed1.flange.s';
    'force2.flange.s' = 'mass2.flange_a.s';
    'force1.flange.s' = 'mass1.flange_a.s';
  annotation(experiment(StopTime = 1.0, Interval = 0.001));
  end 'Modelica_Mechanics_Translational_Examples_Oscillator';
end 'Modelica_Mechanics_Translational_Examples_Oscillator';
