//! base 0.1.0
package 'SpringMassDamper'
  model 'SpringMassDamper' "Mass on a spring with viscous damping"
    parameter Real 'm'(unit = "kg", start = 1.0) = 1.0 "Mass";
    parameter Real 'k'(unit = "N/m", start = 10.0) = 10.0 "Spring stiffness";
    parameter Real 'd'(unit = "N.s/m", start = 0.5) = 0.5 "Damping coefficient";
    Real 'x'(unit = "m", start = 1.0, fixed = true) "Position";
    Real 'v'(unit = "m/s", start = 0.0, fixed = true) "Velocity";
  equation
    der('x') = 'v';
    ('m' * der('v')) = ((-('k' * 'x')) - ('d' * 'v'));
  end 'SpringMassDamper';
end 'SpringMassDamper';
