//! base 0.1.0
package 'Modelica_Electrical_Analog_Examples_CauerLowPassAnalog'
  model 'Modelica_Electrical_Analog_Examples_CauerLowPassAnalog' "Cauer low pass filter with analog components"
    parameter Real 'l1'(quantity = "Inductance", unit = "H") = 1.304 "Filter coefficient I1";
    parameter Real 'l2'(quantity = "Inductance", unit = "H") = 0.8586 "Filter coefficient I2";
    parameter Real 'c1'(quantity = "Capacitance", unit = "F", min = 0) = 1.072 "Filter coefficient c1";
    parameter Real 'c2'(quantity = "Capacitance", unit = "F", min = 0) = (1 / ((1.704992 ^ 2) * 'l1')) "Filter coefficient c2";
    parameter Real 'c3'(quantity = "Capacitance", unit = "F", min = 0) = 1.682 "Filter coefficient c3";
    parameter Real 'c4'(quantity = "Capacitance", unit = "F", min = 0) = (1 / ((1.179945 ^ 2) * 'l2')) "Filter coefficient c4";
    parameter Real 'c5'(quantity = "Capacitance", unit = "F", min = 0) = 0.7262 "Filter coefficient c5";
    Real 'G.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'G.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C1.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C1.v'(quantity = "ElectricPotential", unit = "V", start = 0, fixed = true) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C1.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C1.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C1.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C1.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C1.C'(quantity = "Capacitance", unit = "F", min = 0) = 'c1' "Capacitance";
    Real 'C2.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C2.v'(quantity = "ElectricPotential", unit = "V", start = 0) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C2.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C2.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C2.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C2.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C2.C'(quantity = "Capacitance", unit = "F", min = 0) = 'c2' "Capacitance";
    Real 'C3.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C3.v'(quantity = "ElectricPotential", unit = "V", start = 0, fixed = true) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C3.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C3.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C3.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C3.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C3.C'(quantity = "Capacitance", unit = "F", min = 0) = 'c3' "Capacitance";
    Real 'C4.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C4.v'(quantity = "ElectricPotential", unit = "V", start = 0) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C4.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C4.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C4.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C4.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C4.C'(quantity = "Capacitance", unit = "F", min = 0) = 'c4' "Capacitance";
    Real 'C5.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'C5.v'(quantity = "ElectricPotential", unit = "V", start = 0, fixed = true) "Voltage drop of the two pins (= p.v - n.v)";
    Real 'C5.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C5.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'C5.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'C5.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'C5.C'(quantity = "Capacitance", unit = "F", min = 0) = 'c5' "Capacitance";
    Real 'L1.i'(quantity = "ElectricCurrent", unit = "A", start = 0, fixed = true) "Current flowing from pin p to pin n";
    Real 'L1.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'L1.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'L1.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'L1.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'L1.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'L1.L'(quantity = "Inductance", unit = "H") = 'l1' "Inductance";
    Real 'L2.i'(quantity = "ElectricCurrent", unit = "A", start = 0, fixed = true) "Current flowing from pin p to pin n";
    Real 'L2.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'L2.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'L2.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'L2.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'L2.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'L2.L'(quantity = "Inductance", unit = "H") = 'l2' "Inductance";
    Real 'R1.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'R1.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'R1.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'R1.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'R1.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'R1.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Boolean 'R1.useHeatPort' = false "= true, if heatPort is enabled";
    parameter Real 'R1.T'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 'R1.T_ref' "Fixed device temperature if useHeatPort = false";
    Real 'R1.LossPower'(quantity = "Power", unit = "W") "Loss power leaving component via heatPort";
    Real 'R1.T_heatPort'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, start = 288.15, nominal = 300) "Temperature of heatPort";
    parameter Real 'R1.R'(quantity = "Resistance", unit = "Ohm") = 1 "Resistance at temperature T_ref";
    parameter Real 'R1.T_ref'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 300.15 "Reference temperature";
    parameter Real 'R1.alpha'(quantity = "LinearTemperatureCoefficient", unit = "1/K") = 0 "Temperature coefficient of resistance (R_actual = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'R1.R_actual'(quantity = "Resistance", unit = "Ohm") "Actual resistance = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'R2.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'R2.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'R2.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'R2.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'R2.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'R2.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Boolean 'R2.useHeatPort' = false "= true, if heatPort is enabled";
    parameter Real 'R2.T'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 'R2.T_ref' "Fixed device temperature if useHeatPort = false";
    Real 'R2.LossPower'(quantity = "Power", unit = "W") "Loss power leaving component via heatPort";
    Real 'R2.T_heatPort'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, start = 288.15, nominal = 300) "Temperature of heatPort";
    parameter Real 'R2.R'(quantity = "Resistance", unit = "Ohm") = 1 "Resistance at temperature T_ref";
    parameter Real 'R2.T_ref'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 300.15 "Reference temperature";
    parameter Real 'R2.alpha'(quantity = "LinearTemperatureCoefficient", unit = "1/K") = 0 "Temperature coefficient of resistance (R_actual = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'R2.R_actual'(quantity = "Resistance", unit = "Ohm") "Actual resistance = R*(1 + alpha*(T_heatPort - T_ref))";
    parameter Real 'V.signalSource.offset' = 0 "Offset of output signal y";
    parameter Real 'V.signalSource.startTime'(quantity = "Time", unit = "s") = 1 "Output y = offset for time < startTime";
    Real 'V.signalSource.y' "Connector of Real output signal";
    parameter Real 'V.signalSource.height' = 'V.V' "Height of step";
    parameter Real 'V.offset'(quantity = "ElectricPotential", unit = "V") = 0 "Voltage offset";
    parameter Real 'V.startTime'(quantity = "Time", unit = "s") = 1 "Time offset";
    Real 'V.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'V.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'V.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'V.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'V.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'V.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'V.V'(quantity = "ElectricPotential", unit = "V") = 1 "Height of step";
  equation
    'G.p.v' = 0;
    0 = ('C1.p.i' + 'C1.n.i');
    'C1.i' = 'C1.p.i';
    'C1.v' = ('C1.p.v' - 'C1.n.v');
    'C1.i' = ('C1.C' * der('C1.v'));
    0 = ('C2.p.i' + 'C2.n.i');
    'C2.i' = 'C2.p.i';
    'C2.v' = ('C2.p.v' - 'C2.n.v');
    'C2.i' = ('C2.C' * der('C2.v'));
    0 = ('C3.p.i' + 'C3.n.i');
    'C3.i' = 'C3.p.i';
    'C3.v' = ('C3.p.v' - 'C3.n.v');
    'C3.i' = ('C3.C' * der('C3.v'));
    0 = ('C4.p.i' + 'C4.n.i');
    'C4.i' = 'C4.p.i';
    'C4.v' = ('C4.p.v' - 'C4.n.v');
    'C4.i' = ('C4.C' * der('C4.v'));
    0 = ('C5.p.i' + 'C5.n.i');
    'C5.i' = 'C5.p.i';
    'C5.v' = ('C5.p.v' - 'C5.n.v');
    'C5.i' = ('C5.C' * der('C5.v'));
    0 = ('L1.p.i' + 'L1.n.i');
    'L1.i' = 'L1.p.i';
    'L1.v' = ('L1.p.v' - 'L1.n.v');
    ('L1.L' * der('L1.i')) = 'L1.v';
    0 = ('L2.p.i' + 'L2.n.i');
    'L2.i' = 'L2.p.i';
    'L2.v' = ('L2.p.v' - 'L2.n.v');
    ('L2.L' * der('L2.i')) = 'L2.v';
    0 = ('R1.p.i' + 'R1.n.i');
    'R1.i' = 'R1.p.i';
    'R1.v' = ('R1.p.v' - 'R1.n.v');
    'R1.T_heatPort' = 'R1.T';
    'R1.R_actual' = ('R1.R' * (1 + ('R1.alpha' * ('R1.T_heatPort' - 'R1.T_ref'))));
    'R1.v' = ('R1.R_actual' * 'R1.i');
    'R1.LossPower' = ('R1.v' * 'R1.i');
    0 = ('R2.p.i' + 'R2.n.i');
    'R2.i' = 'R2.p.i';
    'R2.v' = ('R2.p.v' - 'R2.n.v');
    'R2.T_heatPort' = 'R2.T';
    'R2.R_actual' = ('R2.R' * (1 + ('R2.alpha' * ('R2.T_heatPort' - 'R2.T_ref'))));
    'R2.v' = ('R2.R_actual' * 'R2.i');
    'R2.LossPower' = ('R2.v' * 'R2.i');
    'V.signalSource.y' = ('V.signalSource.offset' + (if (time < 'V.signalSource.startTime') then 0 else 'V.signalSource.height'));
    'V.v' = 'V.signalSource.y';
    0 = ('V.p.i' + 'V.n.i');
    'V.i' = 'V.p.i';
    'V.v' = ('V.p.v' - 'V.n.v');
    0 = ((('R1.n.i' + 'C1.p.i') + 'L1.p.i') + 'C2.p.i');
    0 = ((((('C1.n.i' + 'G.p.i') + 'C3.n.i') + 'C5.n.i') + 'R2.n.i') + 'V.n.i');
    0 = (((('L1.n.i' + 'C2.n.i') + 'C3.p.i') + 'C4.p.i') + 'L2.p.i');
    0 = ((('L2.n.i' + 'C4.n.i') + 'C5.p.i') + 'R2.p.i');
    0 = ('R1.p.i' + 'V.p.i');
    'R1.n.v' = 'C1.p.v';
    'C1.p.v' = 'L1.p.v';
    'L1.p.v' = 'C2.p.v';
    'C1.n.v' = 'G.p.v';
    'G.p.v' = 'C3.n.v';
    'C3.n.v' = 'C5.n.v';
    'C5.n.v' = 'R2.n.v';
    'R2.n.v' = 'V.n.v';
    'L1.n.v' = 'C2.n.v';
    'C2.n.v' = 'C3.p.v';
    'C3.p.v' = 'C4.p.v';
    'C4.p.v' = 'L2.p.v';
    'L2.n.v' = 'C4.n.v';
    'C4.n.v' = 'C5.p.v';
    'C5.p.v' = 'R2.p.v';
    'R1.p.v' = 'V.p.v';
    assert(((1 + ('R1.alpha' * ('R1.T_heatPort' - 'R1.T_ref'))) >= 0.0000000000000002220446049250313), "Temperature outside scope of model!");
    assert(((1 + ('R2.alpha' * ('R2.T_heatPort' - 'R2.T_ref'))) >= 0.0000000000000002220446049250313), "Temperature outside scope of model!");
  annotation(experiment(StopTime = 60.0));
  end 'Modelica_Electrical_Analog_Examples_CauerLowPassAnalog';
end 'Modelica_Electrical_Analog_Examples_CauerLowPassAnalog';
