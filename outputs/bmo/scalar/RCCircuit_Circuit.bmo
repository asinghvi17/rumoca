//! base 0.1.0
package 'RCCircuit_Circuit'
  model 'RCCircuit_Circuit' "Step response of an RC low-pass"
    Real 'R1.p.v'(start = 0.0) "Potential";
    Real 'R1.p.i'(start = 0.0) "Current";
    Real 'R1.n.v'(start = 0.0) "Potential";
    Real 'R1.n.i'(start = 0.0) "Current";
    Real 'R1.v'(start = 0.0) "Voltage drop";
    Real 'R1.i'(start = 0.0) "Current through";
    parameter Real 'R1.R'(start = 0.0) = 100.0 "Resistance";
    Real 'C1.p.v'(start = 0.0) "Potential";
    Real 'C1.p.i'(start = 0.0) "Current";
    Real 'C1.n.v'(start = 0.0) "Potential";
    Real 'C1.n.i'(start = 0.0) "Current";
    Real 'C1.v'(start = 0.0, fixed = true) "Voltage drop";
    Real 'C1.i'(start = 0.0) "Current through";
    parameter Real 'C1.C'(start = 0.0) = 0.01 "Capacitance";
    Real 'V1.p.v'(start = 0.0) "Potential";
    Real 'V1.p.i'(start = 0.0) "Current";
    Real 'V1.n.v'(start = 0.0) "Potential";
    Real 'V1.n.i'(start = 0.0) "Current";
    Real 'V1.v'(start = 0.0) "Voltage drop";
    Real 'V1.i'(start = 0.0) "Current through";
    parameter Real 'V1.V'(start = 0.0) = 10.0 "Source voltage";
    Real 'G.p.v'(start = 0.0) "Potential";
    Real 'G.p.i'(start = 0.0) "Current";
  equation
    'R1.v' = ('R1.p.v' - 'R1.n.v');
    0 = ('R1.p.i' + 'R1.n.i');
    'R1.i' = 'R1.p.i';
    'R1.v' = ('R1.R' * 'R1.i');
    'C1.v' = ('C1.p.v' - 'C1.n.v');
    0 = ('C1.p.i' + 'C1.n.i');
    'C1.i' = 'C1.p.i';
    ('C1.C' * der('C1.v')) = 'C1.i';
    'V1.v' = ('V1.p.v' - 'V1.n.v');
    0 = ('V1.p.i' + 'V1.n.i');
    'V1.i' = 'V1.p.i';
    'V1.v' = 'V1.V';
    'G.p.v' = 0;
    0 = ('V1.p.i' + 'R1.p.i');
    0 = ('R1.n.i' + 'C1.p.i');
    0 = (('C1.n.i' + 'V1.n.i') + 'G.p.i');
    'V1.p.v' = 'R1.p.v';
    'R1.n.v' = 'C1.p.v';
    'C1.n.v' = 'V1.n.v';
    'V1.n.v' = 'G.p.v';
  end 'RCCircuit_Circuit';
end 'RCCircuit_Circuit';
