//! base 0.1.0
package 'ForwardParam'
  model 'ForwardParam' "MSL OpAmps examples: vIn.signalSource.amplitude = vIn.V, declared before vIn.V = 2*Vin"
    parameter Real 'c' = 5.0;
    parameter Real 'a' = 'b';
    parameter Real 'b' = (2 * 'c');
    Real 'x'(start = 1.0, fixed = true);
  equation
    der('x') = (-'a') * 'x';
  annotation(experiment(StopTime = 1.0));
  end 'ForwardParam';
end 'ForwardParam';
