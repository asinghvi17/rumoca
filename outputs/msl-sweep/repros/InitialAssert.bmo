//! base 0.1.0
package 'InitialAssert'
  model 'InitialAssert' "assert in an initial algorithm (MSL: FluidHeatFlow SimpleFriction)"
    parameter Real 'k' = 1.0;
    Real 'x'(start = 1.0, fixed = true);
  initial algorithm
    assert('k' > 0, "k has to be > 0");
  equation
    der('x') = (-'k') * 'x';
  annotation(experiment(StopTime = 1.0));
  end 'InitialAssert';
end 'InitialAssert';
