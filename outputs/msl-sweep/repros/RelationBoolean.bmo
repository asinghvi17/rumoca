//! base 0.1.0
package 'RelationBoolean'
  model 'RelationBoolean' "Boolean defined by a relation (MSL: IdealDiode.off, ElastoGap.contact, BooleanStep)"
    Real 'x'(start = 0.5, fixed = true);
    Boolean 'b'(start = false);
    Real 'y';
  equation
    der('x') = -1.0;
    'b' = ('x' > 0);
    'y' = (if 'b' then 1.0 else -1.0);
  annotation(experiment(StopTime = 1.0));
  end 'RelationBoolean';
end 'RelationBoolean';
