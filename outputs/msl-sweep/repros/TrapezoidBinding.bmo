//! base 0.1.0
package 'TrapezoidBinding'
  model 'TrapezoidBinding' "rumoca output of TrapezoidSource.mo; fails in simplify with Bindings for parameters can only be functions of other parameters"
    parameter Real 'Vin' = 5;
    parameter Real 'vIn.signalSource.offset' = (-'Vin') "Offset of output signal y";
    parameter Real 'vIn.signalSource.startTime'(quantity = "Time", unit = "s") = 'vIn.startTime' "Output y = offset for time < startTime";
    Real 'vIn.signalSource.y' "Connector of Real output signal";
    parameter Real 'vIn.signalSource.amplitude' = 'vIn.V' "Amplitude of trapezoid";
    parameter Real 'vIn.signalSource.rising'(quantity = "Time", unit = "s", min = 0) = 0.2 "Rising duration of trapezoid";
    parameter Real 'vIn.signalSource.width'(quantity = "Time", unit = "s", min = 0) = 0.3 "Width duration of trapezoid";
    parameter Real 'vIn.signalSource.falling'(quantity = "Time", unit = "s", min = 0) = 0.2 "Falling duration of trapezoid";
    parameter Real 'vIn.signalSource.period'(quantity = "Time", unit = "s", min = 0.) = 1 "Time for one period";
    parameter Integer 'vIn.signalSource.nperiod' = (-1) "Number of periods (< 0 means infinite number of periods)";
    parameter Real 'vIn.signalSource.T_rising'(quantity = "Time", unit = "s") = 'vIn.signalSource.rising' "End time of rising phase within one period";
    parameter Real 'vIn.signalSource.T_width'(quantity = "Time", unit = "s") = ('vIn.signalSource.T_rising' + 'vIn.signalSource.width') "End time of width phase within one period";
    parameter Real 'vIn.signalSource.T_falling'(quantity = "Time", unit = "s") = ('vIn.signalSource.T_width' + 'vIn.signalSource.falling') "End time of falling phase within one period";
    Real 'vIn.signalSource.T_start'(quantity = "Time", unit = "s") "Start time of current period";
    Integer 'vIn.signalSource.count'(start = 0) "Period count";
    parameter Real 'vIn.offset'(quantity = "ElectricPotential", unit = "V") = (-'Vin') "Voltage offset";
    parameter Real 'vIn.startTime'(quantity = "Time", unit = "s") = 0 "Time offset";
    Real 'vIn.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'vIn.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'vIn.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'vIn.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'vIn.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'vIn.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Real 'vIn.V'(quantity = "ElectricPotential", unit = "V") = (2 * 'Vin') "Amplitude of trapezoid";
    parameter Real 'vIn.rising'(quantity = "Time", unit = "s", min = 0) = 0.2 "Rising duration of trapezoid";
    parameter Real 'vIn.width'(quantity = "Time", unit = "s", min = 0) = 0.3 "Width duration of trapezoid";
    parameter Real 'vIn.falling'(quantity = "Time", unit = "s", min = 0) = 0.2 "Falling duration of trapezoid";
    parameter Real 'vIn.period'(quantity = "Time", unit = "s", min = 0.) = 1 "Time for one period";
    parameter Integer 'vIn.nperiod' = (-1) "Number of periods (< 0 means infinite number of periods)";
    Real 'r.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing from pin p to pin n";
    Real 'r.v'(quantity = "ElectricPotential", unit = "V") "Voltage drop of the two pins (= p.v - n.v)";
    Real 'r.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'r.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    Real 'r.n.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'r.n.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
    parameter Boolean 'r.useHeatPort' = false "= true, if heatPort is enabled";
    parameter Real 'r.T'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 'r.T_ref' "Fixed device temperature if useHeatPort = false";
    Real 'r.LossPower'(quantity = "Power", unit = "W") "Loss power leaving component via heatPort";
    Real 'r.T_heatPort'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, start = 288.15, nominal = 300) "Temperature of heatPort";
    parameter Real 'r.R'(quantity = "Resistance", unit = "Ohm") = 1 "Resistance at temperature T_ref";
    parameter Real 'r.T_ref'(quantity = "ThermodynamicTemperature", unit = "K", displayUnit = "degC", min = 0.0, nominal = 300) = 300.15 "Reference temperature";
    parameter Real 'r.alpha'(quantity = "LinearTemperatureCoefficient", unit = "1/K") = 0 "Temperature coefficient of resistance (R_actual = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'r.R_actual'(quantity = "Resistance", unit = "Ohm") "Actual resistance = R*(1 + alpha*(T_heatPort - T_ref))";
    Real 'g.p.v'(quantity = "ElectricPotential", unit = "V") "Potential at the pin";
    Real 'g.p.i'(quantity = "ElectricCurrent", unit = "A") "Current flowing into the pin";
  initial algorithm
    'vIn.signalSource.count' := integer(((time - 'vIn.signalSource.startTime') / 'vIn.signalSource.period'));
    'vIn.signalSource.T_start' := ('vIn.signalSource.startTime' + ('vIn.signalSource.count' * 'vIn.signalSource.period'));
  equation
    'vIn.signalSource.y' = ('vIn.signalSource.offset' + (if (((time < 'vIn.signalSource.startTime') or ('vIn.signalSource.nperiod' == 0)) or (('vIn.signalSource.nperiod' > 0) and ('vIn.signalSource.count' >= 'vIn.signalSource.nperiod'))) then 0 else (if (time < ('vIn.signalSource.T_start' + 'vIn.signalSource.T_rising')) then (('vIn.signalSource.amplitude' * (time - 'vIn.signalSource.T_start')) / 'vIn.signalSource.rising') else (if (time < ('vIn.signalSource.T_start' + 'vIn.signalSource.T_width')) then 'vIn.signalSource.amplitude' else (if (time < ('vIn.signalSource.T_start' + 'vIn.signalSource.T_falling')) then (('vIn.signalSource.amplitude' * (('vIn.signalSource.T_start' + 'vIn.signalSource.T_falling') - time)) / 'vIn.signalSource.falling') else 0)))));
    'vIn.v' = 'vIn.signalSource.y';
    0 = ('vIn.p.i' + 'vIn.n.i');
    'vIn.i' = 'vIn.p.i';
    'vIn.v' = ('vIn.p.v' - 'vIn.n.v');
    0 = ('r.p.i' + 'r.n.i');
    'r.i' = 'r.p.i';
    'r.v' = ('r.p.v' - 'r.n.v');
    'r.T_heatPort' = 'r.T';
    'r.R_actual' = ('r.R' * (1 + ('r.alpha' * ('r.T_heatPort' - 'r.T_ref'))));
    'r.v' = ('r.R_actual' * 'r.i');
    'r.LossPower' = ('r.v' * 'r.i');
    'g.p.v' = 0;
    0 = ('vIn.p.i' + 'r.p.i');
    0 = (('r.n.i' + 'vIn.n.i') + 'g.p.i');
    'vIn.p.v' = 'r.p.v';
    'r.n.v' = 'vIn.n.v';
    'vIn.n.v' = 'g.p.v';
    assert(((1 + ('r.alpha' * ('r.T_heatPort' - 'r.T_ref'))) >= 0.0000000000000002220446049250313), "Temperature outside scope of model!");
    when (time >= (((pre('vIn.signalSource.count') + 1) * 'vIn.signalSource.period') + 'vIn.signalSource.startTime')) then
      'vIn.signalSource.count' = (pre('vIn.signalSource.count') + 1);
      'vIn.signalSource.T_start' = time;
    end when;
  annotation(experiment(StopTime = 2.0));
  end 'TrapezoidBinding';
end 'TrapezoidBinding';
