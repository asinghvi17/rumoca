//! base 0.1.0
package 'ForRange'
  model 'ForRange'
    constant Integer 'n' = 3;
    parameter Integer 'm' = 2;
    Real 'x[1]'(start = 0, fixed = true);
    Real 'x[2]'(start = 0, fixed = true);
    Real 'x[3]'(start = 0, fixed = true);
  equation
    der('x[1]') = 1;
    der('x[2]') = 2;
    der('x[3]') = 3;
  end 'ForRange';
end 'ForRange';
