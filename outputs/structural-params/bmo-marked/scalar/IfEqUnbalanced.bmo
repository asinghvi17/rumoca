//! base 0.1.0
package 'IfEqUnbalanced'
  model 'IfEqUnbalanced'
    parameter Boolean 'withY' = true annotation(Evaluate = true);
    Real 'x'(start = 0, fixed = true);
    Real 'y'(start = 0, fixed = true);
  equation
    der('x') = 1;
    der('y') = 'x';
  end 'IfEqUnbalanced';
end 'IfEqUnbalanced';
