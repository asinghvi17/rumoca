//! base 0.1.0
package 'ArrayModified'
  model 'ArrayModified'
    parameter Integer 's.n' = 4;
    Real 's.x[1]'(start = 1, fixed = true);
    Real 's.x[2]'(start = 1, fixed = true);
    Real 's.x[3]'(start = 1, fixed = true);
    Real 's.x[4]'(start = 1, fixed = true);
  equation
    der('s.x[1]') = (-'s.x[1]');
    der('s.x[2]') = (-'s.x[2]');
    der('s.x[3]') = (-'s.x[3]');
    der('s.x[4]') = (-'s.x[4]');
  end 'ArrayModified';
end 'ArrayModified';
