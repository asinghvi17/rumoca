//! base 0.1.0
package 'ArraySize'
  model 'ArraySize'
    parameter Integer 'n' = 3;
    Real 'x[1]'(start = 0, fixed = true);
    Real 'x[2]'(start = 0, fixed = true);
    Real 'x[3]'(start = 0, fixed = true);
  equation
    der('x[1]') = ((-(1 * 'x[1]')) + 1);
    der('x[2]') = ((-(2 * 'x[2]')) + 1);
    der('x[3]') = ((-(3 * 'x[3]')) + 1);
  end 'ArraySize';
end 'ArraySize';
