//! base 0.1.0
package 'CondComp'
  model 'CondComp'
    parameter Boolean 'useDamper' = true;
    parameter Real 'dmp.d' = 1;
    Real 'dmp.v'(start = 1, fixed = true);
    Real 'y'(start = 0, fixed = true);
  equation
    der('dmp.v') = (-('dmp.d' * 'dmp.v'));
    der('y') = 1;
  end 'CondComp';
end 'CondComp';
