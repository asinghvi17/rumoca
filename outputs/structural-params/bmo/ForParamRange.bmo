//! base 0.1.0
package 'ForParamRange'
  model 'ForParamRange'
    parameter Integer 'm' = 2;
    Real 'x'[3](start = fill(0, 3), fixed = fill(true, 3));
  equation
    for i in 1:2 loop
      der('x'[i]) = i;
    end for;
    for i in 3:3 loop
      der('x'[i]) = 0;
    end for;
  end 'ForParamRange';
end 'ForParamRange';
